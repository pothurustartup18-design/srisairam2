# ── School ERP mobile app (app-ui) build configuration ─────────────────────────
# Vite only exposes variables prefixed with VITE_. These are baked into the
# bundle at build time, so never put secrets here.

# Backend API base URL including /api. REQUIRED for native (Android) builds.
# Production:
VITE_API_URL=https://18-61-239-173.sslip.io/api

# Update channel the app checks (production | staging). Defaults to production.
# VITE_UPDATE_CHANNEL=production

# Local Wi-Fi testing only (set by scripts/release/local-release.mjs):
# VITE_UPDATE_SERVER_PORT=
