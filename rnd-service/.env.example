# ── School ERP backend configuration ─────────────────────────────────────────
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# ── Runtime ──────────────────────────────────────────────────────────────────
# `production` also enables the fail-fast checks in config/secrets.ts and blocks
# the destructive POST /api/settings/seed endpoint.
NODE_ENV=development
PORT=5000

# Host:port of the FRONTEND, used to build the receipt / report-card
# verification links that go out over WhatsApp and the /superadmin redirect.
# Leaving this at the default puts "localhost:5173" into links parents receive.
APP_HOST=localhost:5173

# Extra browser origins allowed through CORS, comma-separated. localhost:5173 /
# :5174 and private-LAN origins are always allowed. Set this to the deployed
# frontend origin in production, e.g. http://140.245.225.16 or https://erp.example.com
CORS_ALLOWED_ORIGINS=

# ── Database (required) ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/school-erp

# ── Redis (required for caching, login rate limiting and BullMQ workers) ──────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Auth (required) ──────────────────────────────────────────────────────────
# Long random strings. The server refuses to start in production if these are
# unset or left at the development defaults baked into config/secrets.ts.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── AWS S3 (student/teacher documents, media, receipts, backups) ─────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Leave EVERY WHATSAPP_* var unset for simulation mode (messages are logged, not
# sent). A partial configuration is a hard startup error — see config/whatsapp.ts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Required for Meta to verify GET /api/whatsapp/webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Required to verify X-Hub-Signature-256 on incoming webhooks. Without it the
# webhook endpoint accepts unsigned payloads from anyone who knows the URL.
WHATSAPP_APP_SECRET=
# Optional overrides.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_MAX_RETRIES=3
WHATSAPP_DEFAULT_SCHOOL_ID=default
# Fallback template used when the 24h customer-service window has closed.
WHATSAPP_FALLBACK_TEMPLATE_NAME=school_notification
WHATSAPP_FALLBACK_TEMPLATE_LANG=en_US
# Country code prepended to local numbers during E.164 normalisation.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Per-request timeout to the Meta Graph API, ms (1000-120000).
WHATSAPP_HTTP_TIMEOUT_MS=15000
# Identical messages to the same recipient inside this window are suppressed
# as duplicates, ms (0 disables). Queue retry backoff must exceed this or a
# retried send is silently swallowed as a duplicate.
WHATSAPP_DEDUPE_WINDOW_MS=60000
# Set to `warn` to log rather than abort startup when the WhatsApp self-test fails.
WHATSAPP_STARTUP_MODE=

# ── Optional ─────────────────────────────────────────────────────────────────
# Local model directory for @imgly/background-removal-node (signature cleanup).
# Unset means the library downloads its model on first use.
IMG_MODEL_PATH=
